rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/{docId} {
      allow get: if true;
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    // Validation for Analysis Session
    function isValidSession(data) {
      return data.sessionId is string && data.sessionId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.datasetName is string && data.datasetName.size() <= 256 &&
             data.totalRecords is number && data.totalRecords >= 0 &&
             data.numClusters is number && data.numClusters >= 0 &&
             data.numAnomalies is number && data.numAnomalies >= 0 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
             (!('anomalyPercentage' in data) || data.anomalyPercentage is number) &&
             (!('eps' in data) || data.eps is number) &&
             (!('minSamples' in data) || data.minSamples is number) &&
             (!('metric' in data) || (data.metric is string && data.metric.size() <= 32)) &&
             (!('selectedFeatures' in data) || (data.selectedFeatures is list && data.selectedFeatures.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if false;

      // User Sessions Subcollection
      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(sessionId) && isOwner(userId) &&
                         isValidSession(incoming()) &&
                         incoming().userId == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(sessionId) && isOwner(userId) &&
                         isValidSession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().sessionId == existing().sessionId;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }
  }
}
